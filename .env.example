# URL base da API backend
# Emulador Android: 10.0.2.2 = localhost da máquina host
# Dispositivo físico: usar o IP real da máquina na rede local ou domínio em nuvem
EXPO_PUBLIC_API_BASE_URL=https://api.pohinc.com.br

# Habilita o menu e telas de desenvolvimento na interface do app (true na branch dev, false ou ausente em produção)
EXPO_PUBLIC_ENABLE_DEV_MENU=true
