# URL base da API do Barramento Centralizador de Dados Clínicos
# Para testes no Navegador Web:
EXPO_PUBLIC_API_BASE_URL=http://localhost:8002

# Para testes no Emulador Android (10.0.2.2 é o alias padrão do Android para o host local):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8002

# Para testes em Dispositivo Físico via Wi-Fi (substitua pelo IP da sua máquina na rede local):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8002

# Para Ambiente de Produção Oficial:
# EXPO_PUBLIC_API_BASE_URL=https://central.pohinc.com.br
